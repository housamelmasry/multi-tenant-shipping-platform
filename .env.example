# App
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/shipping_db

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Storage
STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=me-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# SMS
SMS_PROVIDER=unifonic
SMS_API_KEY=

# Seed account credentials
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin
DEMO_TENANT_ADMIN_PASSWORD=
DEMO_DRIVER_PASSWORD=

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
