{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "i18n/**/*.json",
        "watchAssets": true
      }
    ],
    "paths": {
      "@common/*": ["common/*"],
      "@modules/*": ["modules/*"],
      "@config/*": ["config/*"],
      "@database/*": ["database/*"],
      "@i18n/*": ["i18n/*"]
    }
  }
}
